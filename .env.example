# Wartości tajne NIE trafiają do repo. Na serwerze plik .env generuje ./scripts/render-env.sh z Vaulta.
# Tu tylko ustawienia jawne i lista kluczy, które muszą istnieć w Vaulcie (wmt/infra).

# --- jawne (opcjonalne) ---
POSTGRES_USER=wmt
POSTGRES_DB=worthmytime
POSTGRES_PORT=5432
LITELLM_PORT=4000
LITELLM_TAG=main-stable
VAULT_PORT=8200
VAULT_TAG=1.18

# --- tajne (źródło prawdy: Vault, ścieżka wmt/infra) ---
POSTGRES_PASSWORD=
LITELLM_DB_PASSWORD=
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
TYPESAFE_API_KEY=
